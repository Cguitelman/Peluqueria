<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Turnos Peluquería</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="app-header">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid app-nav-container">
            <a asp-page="/Index" class="navbar-brand brand-wrap">
                <span class="brand-mark">P</span>
                <span>
                    <strong>Turnos Peluquería</strong>
                    <small>Gestión de agenda</small>
                </span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="navbar-nav main-menu">
                    <a class="nav-link" asp-page="/Index">Inicio</a>
                    <a class="nav-link" asp-page="/Clientes/Index">Clientes</a>
                    <a class="nav-link" asp-page="/Profesionales/Index">Profesionales</a>
                    <a class="nav-link" asp-page="/Servicios/Index">Servicios</a>
                    <a class="nav-link" asp-page="/Turnos/Index">Turnos</a>
                </div>
                <div class="user-area">
                    <span class="version-badge" title="Sirve para verificar que estás ejecutando esta versión">Entrega 2 · SQL Server · Altas OK</span>
                    <div class="user-copy">
                        <strong>@User.Identity.Name</strong>
                        <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    </div>
                    <form method="post" asp-page="/Cuenta/Logout">
                        <button class="btn btn-outline-light btn-sm" type="submit">Salir</button>
                    </form>
                </div>
            }
        </div>
    </nav>
</header>
<main class="container app-container">
    @if (TempData["Success"] is string success)
    {
        <div class="app-alert app-alert-success" role="status">
            <span class="alert-icon">✓</span><span>@success</span>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="app-alert app-alert-error" role="alert">
            <span class="alert-icon">!</span><span>@error</span>
        </div>
    }
    @RenderBody()
</main>

<div id="confirmOverlay" class="confirm-overlay" hidden aria-hidden="true">
    <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="confirm-icon">!</div>
        <h2 id="confirmTitle">Confirmar desactivación</h2>
        <p id="confirmMessage">¿Querés desactivar este registro?</p>
        <p class="confirm-help">El registro no se borra: después vas a poder volver a activarlo.</p>
        <div class="confirm-actions">
            <button type="button" class="btn btn-soft" id="confirmCancel">Cancelar</button>
            <button type="button" class="btn btn-danger" id="confirmAccept">Sí, desactivar</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
