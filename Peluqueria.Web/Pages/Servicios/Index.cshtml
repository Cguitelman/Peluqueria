@page
@model Peluqueria.Web.Pages.Servicios.IndexModel
@{
    ViewData["Title"] = "Servicios";
    var esAdmin = User.IsInRole("Administrador");
}
<div class="page-header"><div><h1>Servicios</h1><p>Catálogo de trabajos, duración y precio.</p></div></div>
@if (esAdmin)
{
<div class="panel">
    <div class="panel-title"><h2>Nuevo servicio</h2><span>La duración se carga en horas, de a media hora.</span></div>
    <form method="post" asp-page-handler="Crear">
        <div asp-validation-summary="All" class="error"></div>
        <div class="grid">
            <div class="field"><label asp-for="Nuevo.Nombre"></label><input asp-for="Nuevo.Nombre" /><span asp-validation-for="Nuevo.Nombre" class="error"></span></div>
            <div class="field"><label asp-for="Nuevo.Descripcion"></label><input asp-for="Nuevo.Descripcion" /><span asp-validation-for="Nuevo.Descripcion" class="error"></span></div>
            <div class="field"><label asp-for="Nuevo.DuracionHoras">Duración (horas)</label><input asp-for="Nuevo.DuracionHoras" type="number" min="0.5" max="10" step="0.5" /><span asp-validation-for="Nuevo.DuracionHoras" class="error"></span><span class="help-text">Ej.: 0,5 h; 1 h; 1,5 h; 2 h.</span></div>
            <div class="field"><label asp-for="Nuevo.Precio"></label><input asp-for="Nuevo.Precio" type="number" min="0" step="0.01" /><span asp-validation-for="Nuevo.Precio" class="error"></span></div>
        </div>
        <div class="mt-3"><button class="btn btn-brand" type="submit">Crear servicio</button></div>
    </form>
</div>
}
else
{
    <div asp-validation-summary="All" class="error"></div>
}
<div class="panel filter-panel">
    <div class="panel-title"><h2>Filtros</h2><span>Buscá servicios por nombre y estado.</span></div>
    <form method="get">
        <div class="filter-grid">
            <div class="field"><label asp-for="FiltroNombre">Nombre del servicio</label><input asp-for="FiltroNombre" placeholder="Ej. Corte" /></div>
            <div class="field"><label asp-for="FiltroRegistro">Estado del registro</label><select asp-for="FiltroRegistro"><option>Todos</option><option>Activos</option><option>Inactivos</option></select></div>
        </div>
        <div class="filter-actions"><button class="btn btn-brand" type="submit">Filtrar</button><a asp-page="./Index" class="btn btn-soft">Limpiar</a></div>
    </form>
</div>
<div class="table-shell"><table>
    <thead><tr><th>Servicio</th><th>Descripción</th><th>Duración</th><th>Precio</th><th>Estado</th>@if(esAdmin){<th>Acciones</th>}</tr></thead>
    <tbody>
    @if (!Model.Servicios.Any()) { <tr><td colspan="6" class="empty-state">No se encontraron servicios con esos filtros.</td></tr> }
    @foreach (var item in Model.Servicios)
    {
        <tr class="@(item.Activo ? "" : "inactive-row")">
            <td><strong>@item.Nombre</strong></td><td>@item.Descripcion</td><td>@item.DuracionHoras.ToString("0.#") h</td><td>@item.Precio.ToString("C")</td>
            <td><span class="status-badge @(item.Activo ? "status-active" : "status-inactive")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
            @if(esAdmin)
            {
                <td class="actions">
                    @if(item.Activo)
                    {
                        <a asp-page="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Editar</a>
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" data-confirm="¿Querés desactivar este servicio?"><button class="btn btn-sm btn-danger" type="submit">Desactivar</button></form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Activar" asp-route-id="@item.Id"><button class="btn btn-sm btn-success" type="submit">Activar</button></form>
                    }
                </td>
            }
        </tr>
    }
    </tbody>
</table></div>
