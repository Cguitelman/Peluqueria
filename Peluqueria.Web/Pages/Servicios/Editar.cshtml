@page "{id:int}"
@model Peluqueria.Web.Pages.Servicios.EditarModel
@{
    ViewData["Title"] = "Editar servicio";
}
<div class="page-header"><div><h1>Editar servicio</h1><p>Actualizá la información del servicio.</p></div></div>
<div class="panel">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <div class="grid">
            <div class="field"><label asp-for="Input.Nombre"></label><input asp-for="Input.Nombre" /></div>
            <div class="field"><label asp-for="Input.Descripcion"></label><input asp-for="Input.Descripcion" /></div>
            <div class="field">
                <label asp-for="Input.DuracionHoras">Duración (horas)</label>
                <input asp-for="Input.DuracionHoras" type="number" min="0.5" max="10" step="0.5" />
                <span asp-validation-for="Input.DuracionHoras" class="error"></span>
                <span class="help-text">Intervalos permitidos: media hora.</span>
            </div>
            <div class="field"><label asp-for="Input.Precio"></label><input asp-for="Input.Precio" type="number" min="0" step="0.01" /></div>
        </div>
        <div class="mt-3 actions"><button class="btn btn-brand" type="submit">Guardar cambios</button><a asp-page="Index" class="btn btn-soft">Cancelar</a></div>
    </form>
</div>
