@page "{id:int}"
@model Peluqueria.Web.Pages.Turnos.EditarModel
@{
    ViewData["Title"] = "Editar turno";
}
<div class="page-header"><div><h1>Editar turno</h1><p>Podés reprogramar un turno futuro o cambiar el estado de uno que ya ocurrió.</p></div></div>
<div class="panel">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <div class="grid">
            <div class="field"><label asp-for="Input.ClienteId">Cliente</label><select asp-for="Input.ClienteId">@foreach(var c in Model.Clientes){<option value="@c.Id">@c.NombreCompleto@(c.Activo ? "" : " (Inactivo)")</option>}</select></div>
            <div class="field"><label asp-for="Input.ProfesionalId">Profesional</label><select asp-for="Input.ProfesionalId">@foreach(var p in Model.Profesionales){<option value="@p.Id">@p.NombreCompleto - @p.Especialidad@(p.Activo ? "" : " (Inactivo)")</option>}</select></div>
            <div class="field"><label asp-for="Input.ServicioId">Servicio</label><select asp-for="Input.ServicioId">@foreach(var s in Model.Servicios){<option value="@s.Id">@s.Nombre (@s.DuracionHoras.ToString("0.#") h)@(s.Activo ? "" : " (Inactivo)")</option>}</select></div>
            <div class="field"><label asp-for="Input.FechaHora">Fecha y hora</label><input asp-for="Input.FechaHora" type="datetime-local" step="1800" /><span asp-validation-for="Input.FechaHora" class="error"></span><span class="help-text">Si cambiás fecha, profesional, cliente o servicio, la nueva fecha debe ser futura.</span></div>
            <div class="field"><label asp-for="Input.Estado">Estado</label><select asp-for="Input.Estado" asp-items="Html.GetEnumSelectList<EstadoTurno>()"></select></div>
        </div>
        <div class="mt-3 actions"><button class="btn btn-brand" type="submit">Guardar cambios</button><a asp-page="Index" class="btn btn-soft">Cancelar</a></div>
    </form>
</div>
